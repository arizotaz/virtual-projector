{
  "name": "virtual-projector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "node better_migration.ts",
    "db:init": "node ./server/database/init_db.ts",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "db:init": "npm run db:init -w server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "react-router-dom": "^7.18.5"
  }
}
