{
  "name": "@virtual-projector/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "seed:admin": "tsx --env-file-if-exists=../.env src/scripts/seed-admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@virtual-projector/shared": "^0.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "mariadb": "^3.5.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
